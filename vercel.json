{
  "regions": [
    "icn1"
  ],
  "ignoreCommand": "test -n \"$VERCEL_GIT_PREVIOUS_SHA\" && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA\" 2>/dev/null && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" \"${VERCEL_GIT_COMMIT_SHA:-HEAD}\" -- . ':(exclude)ios' ':(exclude)android' ':(exclude)docs'",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/players-hero/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/players/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/logos/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/team-logos/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/flags/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/mascot/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/icons/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/broadcast-logos/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/avatars/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/:file(logo|logo-mark|logo-mark-light|og-image|icon-192|icon-512|app-icon|apple-touch-icon|favicon|player-silhouette|logo-with-slogan|slogan).:ext(png|jpg|jpeg|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/admin-broadcast",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/system-metrics-snapshot",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/relay-live-publisher",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/report-blind-notify",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/highlights",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/videos",
      "schedule": "15 */2 * * *"
    },
    {
      "path": "/api/cron/videos-shorts",
      "schedule": "30 12,18 * * *"
    },
    {
      "path": "/api/cron/postgame-interviews",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/stats",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/photos",
      "schedule": "0 21 * * 0"
    },
    {
      "path": "/api/cron/daily-fallback-report",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/daily-analysis",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/daily-analysis-live",
      "schedule": "*/10 7-15 * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/admin-telemetry-retention",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/prewarm-summaries",
      "schedule": "15 8,9,10,11,12,13,14 * * *"
    },
    {
      "path": "/api/cron/game-events-warmup",
      "schedule": "* 5-14 * * *"
    },
    {
      "path": "/api/cron/lineup-watchdog",
      "schedule": "* 4-14 * * *"
    },
    {
      "path": "/api/cron/starter-watchdog",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/game-logs",
      "schedule": "0 14,15,16 * * *"
    },
    {
      "path": "/api/cron/sync-app-downloads",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron/news-clipping",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/news-rag-embed",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/roster-moves",
      "schedule": "*/30 0-10 * * *"
    },
    {
      "path": "/api/cron/admin-alerts",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/discover-channels",
      "schedule": "5 8 * * 0"
    },
    {
      "path": "/api/cron/venue-stories-cleanup",
      "schedule": "20 */2 * * *"
    },
    {
      "path": "/api/cron/venue-stories-finalize",
      "schedule": "*/10 5-18 * * *"
    },
    {
      "path": "/api/cron/leaderboard-rollup",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/api-fallback-alert-drain",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/baseball-qa-drain",
      "schedule": "* * * * *"
    }
  ]
}