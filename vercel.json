{
  "regions": ["icn1"],
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/highlights",
      "schedule": "0 */4 * * *"
    }
  ]
}
