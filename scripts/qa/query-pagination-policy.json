  "boundedRpcAllowlist": {
    "admin_telemetry_retention_run": "returns one retention execution summary object",
    "admin_venue_story_daily": "one aggregated row per KST day (slow-growing daily rollup), same pattern as admin_content_daily",
    "cast_poll_vote": "casts/replaces one user's poll ballot and returns void",
    "claim_api_fallback_alert": "inserts one fallback event, atomically claims one alert lease, returns one boolean should_send",
    "claim_game_summary_generation": "claims one game and returns one monotonic generation token",
    "confirm_api_fallback_alert": "confirms one alert delivery (sets cooldown, clears lease, marks one event), returns void",
    "create_admin_broadcast_job": "creates one job and returns its id",
    "create_poll": "creates one poll (posts+poll_polls+poll_options) and returns one post id",
    "create_venue_story_v2": "creates one story and returns one row",
    "dead_letter_report_blind_notice": "state transition for one notice",
    "delete_any_chat_message": "deletes one message",
    "delete_own_chat_message": "deletes one message",
    "drain_api_fallback_alerts": "returns at most p_max_batch due alert outboxes to re-send (bounded batch)",
    "finish_admin_broadcast_recipient": "state transition for one recipient",
    "increment_post_view": "increments one post counter",
    "leaderboard_invite_rollup_refresh": "full snapshot recompute of the invite leaderboard rollup (advisory-locked, idempotent), returns text",
    "leaderboard_writing_rollup_refresh": "full snapshot recompute of the writing leaderboard rollup, returns void",
    "log_urgent_notice_error": "writes one delivery error",
    "lookup_auth_user_id_by_email": "returns at most one auth.users UUID for one normalized email",
    "nack_api_fallback_alert": "reschedules one alert attempt backoff by token owner, returns void/boolean",
    "record_baseball_genius_news_coverage": "upserts at most one coverage row per team x clip_date (10 teams) and returns a single integer count",
    "record_venue_story_view": "records one dedupe view mark and bumps one daily counter, returns void",
    "record_youtube_quota": "writes one quota ledger entry",
    "replace_team_roster_day": "bounded replacement for one team and date",
    "report_venue_story": "creates one report",
    "reserve_youtube_quota": "returns one atomic quota decision",
    "save_game_summary_if_current": "conditionally saves one game summary and returns one boolean",
    "upsert_baseball_genius_news_articles": "upserts a jsonb batch (hard-capped at 500 rows inside the function) and returns exactly one summary row",
    "upsert_naver_identity": "upserts one authenticated identity",
    "venue_stats_season_team_aggregates": "returns one jsonb aggregate (per-team season totals + per-game ledger verification flags for one season, ~1.5k bounded entries)"
  }
}
