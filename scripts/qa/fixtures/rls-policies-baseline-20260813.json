  "cmd": "INSERT",
  "qual": null,
  "with_check": "((user1_id IS NOT NULL) AND (user2_id IS NOT NULL) AND ((auth.uid() = user1_id) OR (auth.uid() = user2_id)) AND (NOT (EXISTS ( SELECT 1\n   FROM user_blocks\n  WHERE (((user_blocks.blocker_id = dm_conversations.user1_id) AND (user_blocks.blocked_id = dm_conversations.user2_id)) OR ((user_blocks.blocker_id = dm_conversations.user2_id) AND (user_blocks.blocked_id = dm_conversations.user1_id)))))))"
 },
