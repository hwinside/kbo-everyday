# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# 서명/시크릿 — 리포 어디에도 커밋 금지(루트 방어층, android/.gitignore와 이중)
*.jks
*.keystore
keystore.properties

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Capacitor native projects (build artifacts, user-specific settings)
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App/public/
android/.gradle/
android/app/build/
android/app/src/main/assets/public/
android/local.properties

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
test-results/
keubofan-analytics-sa.json

# design-v2 reference (시각 기준 SSOT, binary-heavy, git 포함 안 함)
specs/design-v2-reference/uploads/
specs/design-v2-reference/scraps/
design-v2-reference.v0-backup/
tmp/

# cutouts-v2 배치 산출물 (logs/백업/런타임 생성 JSON 제외)
scripts/cutouts-v2/logs/
scripts/cutouts-v2/phase2-todo-backup-*.json
scripts/cutouts-v2/phase2-todo-new-*.json
.worktrees/
scripts/hero/.daum-src/

# 실기기 QA 산출물 (게이트 JSON·인벤토리 등) — 커밋 대상 아님
.qa-artifacts/
# 실모델 before/after 게이트가 런타임에 git show 로 꺼내 쓰는 구 pipeline 스냅샷.
# 상대 import 를 살리려고 src 안에 떨어뜨렸다가 즉시 지운다 — 커밋 대상이 아니다.
src/lib/baseball-qa/.before-snapshot.*.ts
src/lib/baseball-qa/.before-pipeline.*.ts
src/lib/baseball-qa/.before-request.*.ts
