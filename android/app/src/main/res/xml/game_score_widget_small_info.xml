<?xml version="1.0" encoding="utf-8"?>
<!-- 스몰(2x2) 위젯 — iOS systemSmall 등가. 컴팩트 카드(로고+점수+상태). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_game_score_small"
    android:description="@string/widget_game_score_small_desc"
    android:previewImage="@drawable/widget_preview_game_score_small"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />
