<?xml version="1.0" encoding="utf-8"?>
<!-- 잠금화면/홈 App Widget — iOS MY TEAM 카드(IMG_6990)와 동일, BSO 제외.
     배경=최애팀 컬러 그라데이션, 반투명 팀 로고 워터마크, MY TEAM 헤더,
     양팀 로고+약어+점수, LIVE 이닝 pill, 투수/타자, 베이스 다이아몬드.
     RemoteViews 제약상 FrameLayout/LinearLayout/ImageView/TextView만 사용. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_lg">

    <!-- 배경 반투명 팀 로고 워터마크 (우상단) -->
    <ImageView
        android:id="@+id/widget_wm"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_wm_lg"
        android:contentDescription="@null" />

    <!-- 빈 상태 (경기 없음) -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/notosanskr"
        android:letterSpacing="-0.04"
        android:textColor="#A1A1AA"
        android:textSize="13sp"
        android:visibility="gone"
        android:text="경기 정보가 없어요" />

    <!-- 카드 본문 -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- MY TEAM 헤더 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/widget_myteam_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/teamlogo_lg"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/widget_myteam_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- 스코어 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- away 컬럼 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/widget_away_logo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/teamlogo_sk"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_away_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- 가운데: 점수 + 상태 pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <!-- 경기 날짜('6월 7일 (토)') — 예정 경기일 때 표시. 숫자(Montserrat)+한글(Noto)
                     혼합이라 RemoteViews에서 폰트가 안 먹어 비트맵으로 렌더(widget_date). -->
                <ImageView
                    android:id="@+id/widget_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:adjustViewBounds="true"
                    android:visibility="gone"
                    android:contentDescription="@null" />
                <!-- 경기장(잠실) — 가운데 점수 위 별도 표시 -->
                <TextView
                    android:id="@+id/widget_stadium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:fontFamily="@font/notosanskr"
                    android:letterSpacing="-0.04"
                    android:textColor="#AEAEB4"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:text="잠실" />
                <!-- 스코어 — Montserrat 숫자, RemoteViews 폰트 미적용 회피 위해 비트맵 렌더 -->
                <ImageView
                    android:id="@+id/widget_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/widget_score_scheduled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/notosanskr"
                    android:letterSpacing="-0.04"
                    android:textColor="#F5F5F7"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:visibility="gone"
                    android:text="경기 예정" />
<!-- 상태 pill — LIVE N회초/시각/경기 종료. 숫자(Montserrat)+한글(Noto) 혼합이라 비트맵 렌더 -->
                <LinearLayout
                    android:id="@+id/widget_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/widget_status_pill"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/widget_status_img"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- home 컬럼 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/widget_home_logo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/teamlogo_lg"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_home_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- 예고선발 행 — 예정 경기에서만 표시(양팀 예고선발, 미확정이면 "선발 미정").
             혼합(한글+영문) 이름이라 비트맵 렌더(widget_away_starter/widget_home_starter). -->
        <View
            android:id="@+id/widget_starter_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#22FFFFFF"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/widget_starter_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_away_starter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scaleType="center"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/widget_home_starter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scaleType="center"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- 하단: (OUT + 투수/타자 소속표기) + 다이아몬드 — SSOT lockscreen-card-approved -->
        <LinearLayout
            android:id="@+id/widget_live_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 좌측: OUT 카운트 + 투수/타자 2줄 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 아웃카운트 (B/S 제거, OUT만) -->
                <ImageView
                    android:id="@+id/widget_out"
                    android:layout_width="74dp"
                    android:layout_height="20dp"
                    android:layout_marginBottom="6dp"
                    android:scaleType="fitStart"
                    android:src="@drawable/out_0"
                    android:contentDescription="@null" />

                <!-- 투수 (소속) 이름 -->
                <LinearLayout
                    android:id="@+id/widget_pitcher_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/widget_pitcher_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/notosanskr"
                        android:letterSpacing="-0.04"
                        android:textColor="#AEAEB4"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:text="투수" />
                    <TextView
                        android:id="@+id/widget_pitcher_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/notosanskr"
                        android:letterSpacing="-0.04"
                        android:textColor="#F2F2F5"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="" />
                </LinearLayout>

                <!-- 타자 (소속) 이름 -->
                <LinearLayout
                    android:id="@+id/widget_batter_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/widget_batter_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/notosanskr"
                        android:letterSpacing="-0.04"
                        android:textColor="#AEAEB4"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:text="타자" />
                    <TextView
                        android:id="@+id/widget_batter_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/notosanskr"
                        android:letterSpacing="-0.04"
                        android:textColor="#F2F2F5"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_diamond"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/diamond_000"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
