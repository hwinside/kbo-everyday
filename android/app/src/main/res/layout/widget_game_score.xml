<?xml version="1.0" encoding="utf-8"?>
<!-- 잠금화면/홈 App Widget — iOS MY TEAM 카드(IMG_6990)와 동일, BSO 제외.
     배경=최애팀 컬러 그라데이션, 반투명 팀 로고 워터마크, MY TEAM 헤더,
     양팀 로고+약어+점수, LIVE 이닝 pill, 투수/타자, 베이스 다이아몬드.
     RemoteViews 제약상 FrameLayout/LinearLayout/ImageView/TextView만 사용. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_lg">

    <!-- 배경 반투명 팀 로고 워터마크 (우상단) -->
    <ImageView
        android:id="@+id/widget_wm"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_wm_lg"
        android:contentDescription="@null" />

    <!-- 빈 상태 (경기 없음) -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/notosanskr_vf"
        android:letterSpacing="-0.04"
        android:textColor="#A1A1AA"
        android:textSize="13sp"
        android:visibility="gone"
        android:text="경기 정보가 없어요" />

    <!-- 카드 본문 -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- MY TEAM 헤더 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/widget_myteam_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/teamlogo_lg"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/montserrat_vf"
                android:textColor="#E0506A"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="-0.02"
                android:text="MY TEAM" />
        </LinearLayout>

        <!-- 스코어 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- away 컬럼 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/widget_away_logo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/teamlogo_sk"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/widget_away_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/notosanskr_vf"
                    android:letterSpacing="-0.04"
                    android:textColor="#E8B0BC"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:text="SSG" />
            </LinearLayout>

            <!-- 가운데: 점수 + 상태 pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/widget_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_vf"
                    android:letterSpacing="-0.02"
                    android:textColor="#F5F5F7"
                    android:textStyle="bold"
                    android:textSize="30sp"
                    android:text="2 : 1" />
                <TextView
                    android:id="@+id/widget_score_scheduled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/notosanskr_vf"
                    android:letterSpacing="-0.04"
                    android:textColor="#F5F5F7"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:visibility="gone"
                    android:text="경기 예정" />
                <TextView
                    android:id="@+id/widget_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/widget_status_pill"
                    android:fontFamily="@font/notosanskr_vf"
                    android:letterSpacing="-0.04"
                    android:textColor="#FF6B7A"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:text="LIVE 2회초" />
            </LinearLayout>

            <!-- home 컬럼 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/widget_home_logo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/teamlogo_lg"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/widget_home_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/notosanskr_vf"
                    android:letterSpacing="-0.04"
                    android:textColor="#E8B0BC"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:text="LG" />
            </LinearLayout>
        </LinearLayout>

        <!-- 하단: (OUT + 투수/타자 소속표기) + 다이아몬드 — SSOT lockscreen-card-approved -->
        <LinearLayout
            android:id="@+id/widget_live_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 좌측: OUT 카운트 + 투수/타자 2줄 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 아웃카운트 (B/S 제거, OUT만) -->
                <ImageView
                    android:id="@+id/widget_out"
                    android:layout_width="74dp"
                    android:layout_height="20dp"
                    android:layout_marginBottom="6dp"
                    android:scaleType="fitStart"
                    android:src="@drawable/out_0"
                    android:contentDescription="@null" />

                <!-- 투수 (소속) 이름 -->
                <LinearLayout
                    android:id="@+id/widget_pitcher_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/widget_pitcher_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/notosanskr_vf"
                        android:letterSpacing="-0.04"
                        android:textColor="#AEAEB4"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:text="투수" />
                    <TextView
                        android:id="@+id/widget_pitcher_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/notosanskr_vf"
                        android:letterSpacing="-0.04"
                        android:textColor="#F2F2F5"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="" />
                </LinearLayout>

                <!-- 타자 (소속) 이름 -->
                <LinearLayout
                    android:id="@+id/widget_batter_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/widget_batter_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/notosanskr_vf"
                        android:letterSpacing="-0.04"
                        android:textColor="#AEAEB4"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:text="타자" />
                    <TextView
                        android:id="@+id/widget_batter_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/notosanskr_vf"
                        android:letterSpacing="-0.04"
                        android:textColor="#F2F2F5"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_diamond"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/diamond_000"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
