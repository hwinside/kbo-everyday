<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 이하 splash. 12+ 는 styles.xml의 SplashScreen API(단색+아이콘) 사용. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#03306A" android:endColor="#001026" />
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/splash_icon" android:gravity="center" />
    </item>
</layer-list>
